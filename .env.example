# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Auth ---------------------------------------------------------------
# auto = use your Claude Code subscription login first, fall back to the API key
#        on an auth failure or usage-limit error; subscription | api_key force one mode.
AUTH_MODE=auto
# Only used as a fallback (or when AUTH_MODE=api_key). Never exported to the agent otherwise.
ANTHROPIC_API_KEY=
# Kept for reference only (not used by the Agent SDK).
ANTHROPIC_WORKSPACE_ID=

# --- Model / agent ------------------------------------------------------
MODEL=claude-haiku-5-5
MAX_TURNS=12
MAX_WEB_SEARCHES=2
MAX_WEB_FETCHES=3
EFFORT=low

# --- Budget (API-equivalent USD, counted from budget_ledger.jsonl) -------
TOTAL_BUDGET_USD=10
DAILY_APP_BUDGET_USD=1

# --- App behaviour ------------------------------------------------------
FACTCHECK_MODE=both            # continuous | hotkey | both
FACTCHECK_DISPLAY=both         # overlay | panel | both
CAPTURE_INTERVAL_S=2
HOTKEY=ctrl+alt+f
BLOCKED_APPS=1password.exe,keepass.exe,bitwarden.exe,keepassxc.exe
SERVER_PORT=8765
KEEP_AGENT_WORK=false
FACTCHECK_FAKE_LLM=false       # true = deterministic fake verdicts (tests, UI work, $0)

# --- Live steno mode (factcheck-steno; guide: docs/steno-live.md) --------
# Uses the Messages API directly (needs ANTHROPIC_API_KEY above). Two stages:
# a fast model on every new picture, a stronger one once the picture stays still.
STENO_FAST_MODEL=claude-haiku-5-5
STENO_FAST_EFFORT=low
STENO_FAST_THINKING=off
STENO_DEEP_MODEL=claude-opus-5-5   # empty = fast stage only
STENO_DEEP_EFFORT=low
STENO_DEEP_AUTO=true               # false = deep stage only via button / hotkey
STENO_DEEP_AFTER_S=2.5
STENO_FPS=4                        # local change detection, costs nothing
STENO_MAX_IMAGE_EDGE=1568          # up to 2576 / 4784 for more detail (slower, pricier)
STENO_MAX_IMAGE_TOKENS=1568
STENO_DAILY_BUDGET_USD=2           # all steno calls per day; TOTAL_BUDGET_USD above still applies
STENO_DEEP_BUDGET_SHARE=0.8
STENO_HINT=                        # default text for the hint field, e.g. Finde den Fehler
STENO_KNOWLEDGE_FILE=              # your own course notes instead of src/factcheck/steno/knowledge/dek.md
STENO_SAVE_FRAMES=false
STENO_FAKE=false                   # true = placeholder analyses, no API calls ($0)
STENO_HOTKEY_NOW=ctrl+alt+s
STENO_HOTKEY_DEEP=ctrl+alt+d
STENO_HOTKEY_REGION=ctrl+alt+r
STENO_HOTKEY_OVERLAY=ctrl+alt+o
STENO_HOTKEY_PAUSE=ctrl+alt+p
